{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "design-repo/schema/pagespec.schema.json",
 "title": "PageSpec",
 "description": "A page composed from this design-repo. mode=reference reconstructs the reference build faithfully; mode=generated builds a new page for someone else and must contain no source identity or content (schema/semantic_validate.py GENERATED_MODE_* rules). DERIVED by extraction/build_derived.py - do not hand-edit.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "pageSpecVersion",
  "mode",
  "template",
  "route",
  "locale",
  "theme",
  "meta",
  "brand",
  "nodes"
 ],
 "properties": {
  "pageSpecVersion": {
   "const": "1.0.0"
  },
  "mode": {
   "enum": [
    "reference",
    "generated"
   ]
  },
  "template": {
   "enum": [
    "cosmos-home",
    "case-study"
   ]
  },
  "route": {
   "type": "string",
   "pattern": "^/"
  },
  "locale": {
   "enum": [
    "en"
   ]
  },
  "theme": {
   "enum": [
    "dark"
   ]
  },
  "meta": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "description"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1
    },
    "description": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "brand": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "ownerName",
    "studioName",
    "domain"
   ],
   "properties": {
    "ownerName": {
     "type": "string",
     "minLength": 1
    },
    "studioName": {
     "type": "string",
     "minLength": 1
    },
    "domain": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "nodes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/definitions/node"
   }
  }
 },
 "definitions": {
  "link": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "label",
    "href"
   ],
   "properties": {
    "label": {
     "type": "string",
     "minLength": 1
    },
    "href": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "media": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "assetRole",
    "ref",
    "alt"
   ],
   "properties": {
    "assetRole": {
     "enum": [
      "brand.logo-mark",
      "brand.name-lettering",
      "brand.signature-trace",
      "fictional.person",
      "font.display-original",
      "generated.brand-mark",
      "generated.name-lettering",
      "generated.portrait-silhouette",
      "generated.signature",
      "generated.work-visual",
      "icon.ui",
      "licensed-or-fallback.font",
      "original.copy",
      "placeholder.brand-mark",
      "placeholder.metric",
      "placeholder.url",
      "placeholder.work-video",
      "portrait.subject-photo",
      "social.share-image-original",
      "user.portrait-photo",
      "user.work-media",
      "work.piece-image",
      "work.piece-video"
     ]
    },
    "ref": {
     "type": "string",
     "minLength": 1
    },
    "alt": {
     "type": "string"
    }
   }
  },
  "tokens": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "surface": {
     "type": "string",
     "minLength": 1
    },
    "text": {
     "type": "string",
     "minLength": 1
    },
    "spaceBlock": {
     "type": "string",
     "minLength": 1
    },
    "font": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "motion": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "pattern",
    "reducedMotionFallback"
   ],
   "properties": {
    "pattern": {
     "enum": [
      "arrow-bob",
      "box-slide",
      "case-reveal",
      "chip-toggle",
      "fade-layers",
      "field-focus",
      "flybar-reveal",
      "focus-drift",
      "halo-drift",
      "hero-fade",
      "hud-follow",
      "image-develop",
      "loader-draw",
      "menu-panel",
      "next-case-hover",
      "none",
      "pill-press",
      "pointer-parallax",
      "portrait-arrival",
      "rewind",
      "scroll-travel",
      "side-reveal",
      "signature-draw",
      "tile-hover",
      "toast-rise",
      "underline-grow",
      "view-crossfade"
     ]
    },
    "reducedMotionFallback": {
     "enum": [
      "none",
      "instant",
      "static-final-state",
      "disabled",
      "unchanged"
     ]
    }
   }
  },
